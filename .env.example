# ==============================================================================
# SRIT Social Media Feeds - API Configuration
# ==============================================================================
# Copy this file to `.env` (or add these variables in your hosting provider's dashboard,
# e.g., Vercel, Netlify, Render, Railway, AWS, etc.).
#
# IMPORTANT SECURITY RULES:
# - NEVER commit `.env` or access tokens to GitHub.
# - NEVER prefix these with VITE_ (VITE_ variables are bundled into client-side JS!).
# - All API requests to Meta / Graph API are performed SERVER-SIDE ONLY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INSTAGRAM GRAPH API (Professional / Business / Creator Account)
# ------------------------------------------------------------------------------
# NOTE: Instagram Basic Display API was officially discontinued on December 4, 2024.
# Current integrations require the official Instagram Graph API:
#
# - INSTAGRAM_ACCOUNT_ID: The Instagram Business/Creator Account ID (numeric, e.g. 17841400...).
#   (If omitted, the server will attempt to auto-discover it from the linked Facebook Page).
# - INSTAGRAM_ACCESS_TOKEN: A Long-Lived System User, User, or Page Access Token with
#   `instagram_basic`, `pages_show_list`, and `pages_read_engagement` permissions.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 2. FACEBOOK GRAPH API (Page Posts)
# ------------------------------------------------------------------------------
# - FACEBOOK_PAGE_ID: Official SRIT Facebook Page ID (e.g. 190643840980550 or sritatp)
# - FACEBOOK_PAGE_ACCESS_TOKEN: A Long-Lived Page Access Token with `pages_read_user_content`
#   and `pages_read_engagement` permissions.
#   (Generate via Meta for Developers -> Graph API Explorer -> Get Page Access Token)
FACEBOOK_PAGE_ID=190643840980550
FACEBOOK_PAGE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. CRON / WEBHOOK SECRET (Optional)
# ------------------------------------------------------------------------------
# Protects the `/api/social-feeds?refresh=true` endpoint from excessive external hits
# if invoked by automated cron services (e.g. cron-job.org, GitHub Actions, Vercel Cron).
SOCIAL_SYNC_SECRET=
